# Trip guide API settings. Copy to .env (which is never committed) and fill in. No real secret belongs in this file.

# development | staging | production.  staging keeps the demo helpers; production hides them.
APP_ENV=development
PORT=3000

# PostgreSQL 16. Leave empty in development to use an embedded database kept in ./data/pg.
# Example: postgres://tripguide:tripguide@localhost:5432/tripguide
DATABASE_URL=
# Redis for rate limits. Leave empty to count in memory (single process only).
REDIS_URL=

# The website's address (for CORS), comma separated. The phone apps' origins are always allowed.
WEB_ORIGIN=
# This API's public address, used in media links. Example: https://api.example.com
PUBLIC_URL=http://localhost:3000
# A random string of 32+ characters. Signs SMS codes and private media links. Required on staging and production.
TOKEN_SECRET=
# How many days a sign-in lasts without being used.
SESSION_DAYS=30
# Set to 1 when the API runs behind a proxy or load balancer that ends HTTPS.
TRUST_PROXY=

# The state (admin) account, created on first start. The password is stored hashed only.
# Put the real password in .env only. Never in code, tests, logs or commits.
ADMIN_PHONE=+9647713111325
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Trip guide team

# 1 = fill an empty database with the demo data (staging). Never on production.
SEED_DEMO=

# Media storage: disk (a folder; development) or s3 (any S3-compatible storage).
MEDIA_DRIVER=disk
MEDIA_DIR=data/media
S3_ENDPOINT=
# The storage address as browsers reach it (signed links of private photos). Empty = the same as S3_ENDPOINT.
S3_BROWSER_ENDPOINT=
S3_REGION=us-east-1
# Public photos (covers, profile and tour photos, passport photos, event photos).
S3_BUCKET=
# Private photos (ID and residence cards): reachable only through short-lived signed links, for the state only.
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public address of S3_BUCKET (a CDN or the bucket URL).
S3_PUBLIC_URL=
# 1 for MinIO and other path-style storage.
S3_FORCE_PATH_STYLE=
# 1 = create the two buckets on start (local MinIO only; in production create them yourself).
S3_CREATE_BUCKETS=

# SMS: log = write the code to the server log (development). A real provider is added once chosen.
SMS_PROVIDER=log
# Payments: simulated = behaves exactly like the demo.
PAYMENT_PROVIDER=simulated
# on | off
RATE_LIMIT=on
LOG_LEVEL=info

# Trip assistant (docs/AI_ASSISTANT.md). Empty AI_PROVIDER = off.  openai | anthropic | mock
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
