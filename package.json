{
  "name": "tripguide",
  "private": true,
  "version": "0.1.0",
  "description": "A marketplace that connects tourists in Iraq with local guides: post a trip, compare offers, hire, pay day by day.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/build.mjs && node dist/server.mjs",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs",
    "reset": "node scripts/reset.mjs",
    "test": "tsx --test src/core/*.test.ts src/server/*.test.ts src/api/*.test.ts",
    "e2e": "tsx --test e2e/flows.test.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsx scripts/check-strings.ts",
    "build:app": "node scripts/build.mjs --app",
    "cap:sync": "node scripts/build.mjs --app && cap sync",
    "android": "node scripts/build.mjs --app && cap sync android && cap open android",
    "ios": "node scripts/build.mjs --app && cap sync ios && cap open ios",
    "apk": "node scripts/build.mjs --app && cap sync android && cd android && ./gradlew assembleDebug",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#053F5C\" --splashBackgroundColor \"#FFFFFF\"",
    "api": "node scripts/build.mjs && node dist/api.mjs",
    "api:dev": "tsx watch src/api/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cors": "^11.4.3",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
